{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "nodemon",
    "start": "node build/server.js",
    "gen:proto": "proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=src/generated/ src/protos/*.proto",
    "build": "rimraf ./build && tsc -p . && cp -r src/protos build/protos",
    "debug": "GRPC_VERBOSITY=DEBUG GRPC_TRACE=all nodemon"
  },
  "author": "Vadim Tverdokhlebov",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^17.0.30",
    "rimraf": "^3.0.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.6.7",
    "@types/google-protobuf": "^3.15.6",
    "dotenv": "^16.0.0",
    "nodemon": "^3.1.10",
    "winston": "^3.7.2"
  }
}

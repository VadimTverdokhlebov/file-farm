{
  "name": "file-farm-server",
  "version": "1.0.0",
  "author": "Vadim Tverdokhlebov",
  "license": "ISC",
  "scripts": {
    "dev": "nodemon",
    "start": "node build/server.js",
    "gen:proto": "rm -rf src/generated && mkdir -p src/generated && proto-loader-gen-types --grpcLib=@grpc/grpc-js --outDir=src/generated/ ../protos/*.proto",
    "build": "rimraf ./build && tsc -p . && (cp -r ../protos build/protos 2>/dev/null || cp -r ./protos build/protos 2>/dev/null || true)",
    "debug": "GRPC_VERBOSITY=DEBUG GRPC_TRACE=all nodemon"
  },
  "devDependencies": {
    "@types/node": "^17.0.30",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.1.10",
    "rimraf": "^3.0.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.6.7",
    "@grpc/proto-loader": "^0.8.0",
    "@grpc/reflection": "^1.0.4",
    "dotenv": "^16.0.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "uuid": "^14.0.1",
    "winston": "^3.7.2"
  }
}

      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{name=~\"file-farm-server-[123]\"}[1m])",
          "legendFormat": "rx {{name}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{name=~\"file-farm-server-[123]\"}[1m])",

      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{name=~\"file-farm-server-[123]\"}[1m])",
          "legendFormat": "read {{name}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{name=~\"file-farm-server-[123]\"}[1m])",

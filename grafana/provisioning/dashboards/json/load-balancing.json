    {
      "datasource": { "type": "prometheus" },
      "description": "Показывает, что Docker принудительно ограничивает CPU (контейнер хотел больше 1 ядра, но не получил). Ненулевое значение = лимит CPU реально срабатывает.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(container_cpu_cfs_throttled_seconds_total{name=~\"file-farm-server-[123]\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "CPU throttling (limit hit indicator)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "description": "total upstream rq — суммарный RPS через Envoy к кластеру grpc_backend (все 3 сервера). healthy endpoints — сколько backend'ов прошли health check (должно быть 3).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "healthy endpoints" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=\"grpc_backend\"}[1m]))",
          "legendFormat": "total upstream rq",
          "refId": "A"
        },
        {
          "expr": "envoy_cluster_membership_healthy{envoy_cluster_name=\"grpc_backend\"}",
          "legendFormat": "healthy endpoints",
          "refId": "B"

{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "prometheus" },
        "enable": true,
        "expr": "load_stand_test_running == 1",
        "hide": false,
        "iconColor": "green",
        "name": "Load test",
        "tagKeys": "preset,concurrency",
        "textFormat": "preset={{preset}} concurrency={{concurrency}}",
        "titleFormat": "Running"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Summary (uses Grafana time range: top-right — Last 5m / 15m)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "expr": "sum(rate(file_farm_grpc_requests_total{exported_instance=~\"$server\", method=~\"$method\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "title": "Total gRPC RPS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "description": "Lower = more even load across servers.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.15 }, { "color": "red", "value": 0.3 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "expr": "stddev(sum by (exported_instance) (rate(file_farm_grpc_requests_total{exported_instance=~\"$server\", method=~\"$method\"}[2m]))) / avg(sum by (exported_instance) (rate(file_farm_grpc_requests_total{exported_instance=~\"$server\", method=~\"$method\"}[2m])))",
          "legendFormat": "fairness",
          "refId": "A"
        }
      ],
      "title": "Fairness (stddev/mean)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["mean"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_cluster_external_upstream_rq_time_bucket{envoy_cluster_name=\"grpc_backend\"}[$__rate_interval]))) / 1000",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "title": "Envoy upstream p99",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "color": "red", "text": "stopped" }, "1": { "color": "green", "text": "running" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "load_stand_test_running", "refId": "A" }],
      "title": "Load test",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 110,
      "title": "Load balancing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (exported_instance, method) (rate(file_farm_grpc_requests_total{exported_instance=~\"$server\", method=~\"$method\"}[1m]))",
          "legendFormat": "server-{{exported_instance}} {{method}}",
          "refId": "A"
        }
      ],
      "title": "gRPC RPS per server",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (envoy_endpoint_address) (rate(envoy_cluster_endpoint_rq_total{envoy_cluster_name=\"grpc_backend\"}[1m]))",
          "legendFormat": "{{envoy_endpoint_address}}",
          "refId": "A"
        }
      ],
      "title": "Envoy RPS per upstream endpoint",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 120,
      "title": "Control plane",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 15 },
      "id": 7,
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name" },
      "targets": [
        { "expr": "lb_controller_algorithm_info{algorithm=~\"$algorithm\"}", "legendFormat": "{{algorithm}}", "refId": "A" }
      ],
      "title": "LB algorithm",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 15 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{ "expr": "lb_controller_endpoint_weight", "legendFormat": "{{host}}", "refId": "A" }],
      "title": "Endpoint weights (EDS)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 130,
      "title": "Errors & latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (exported_instance) (rate(file_farm_grpc_requests_total{status=\"error\", exported_instance=~\"$server\", method=~\"$method\"}[1m]))",
          "legendFormat": "server-{{exported_instance}}",
          "refId": "A"
        }
      ],
      "title": "gRPC error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2 }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(envoy_cluster_external_upstream_rq_time_bucket{envoy_cluster_name=\"grpc_backend\"}[2m]))) / 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(envoy_cluster_external_upstream_rq_time_bucket{envoy_cluster_name=\"grpc_backend\"}[2m]))) / 1000",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "title": "Envoy upstream latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 140,
      "title": "Server resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "max": 1, "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 29 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max by (name) (rate(container_cpu_usage_seconds_total{name=~\"file-farm-server-[123]\"}[1m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "CPU per server",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 29 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max by (name) (container_memory_usage_bytes{name=~\"file-farm-server-[123]\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Memory per server",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 29 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "file_farm_grpc_active_requests{exported_instance=~\"$server\"}",
          "legendFormat": "in-flight server-{{exported_instance}}",
          "refId": "A"
        },
        {
          "expr": "envoy_cluster_membership_healthy{envoy_cluster_name=\"grpc_backend\"}",
          "legendFormat": "healthy endpoints",
          "refId": "B"
        }
      ],
      "title": "In-flight requests & healthy backends",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["file-farm", "load-balancing"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "includeAll": true,
        "label": "Server",
        "multi": true,
        "name": "server",
        "query": "label_values(file_farm_grpc_requests_total, exported_instance)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "includeAll": true,
        "label": "Method",
        "multi": true,
        "name": "method",
        "query": "label_values(file_farm_grpc_requests_total, method)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus" },
        "includeAll": true,
        "label": "Algorithm",
        "multi": false,
        "name": "algorithm",
        "query": "label_values(lb_controller_algorithm_info, algorithm)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "File Farm Load Balancing",
  "uid": "file-farm-lb",
  "version": 1
}

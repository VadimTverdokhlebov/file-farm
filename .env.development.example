# Development Environment Variables
# Copy this file to .env and adjust values as needed

# Environment
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_DB=appdb
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database connection URL (used by server)
DATABASE_URL=postgres://app:secret@postgres:5432/appdb

# Server Configuration
GRPC_PORT=50051
GRPC_PROTO_FILE=protos/service.proto
FILES_DIR=./uploads

# MongoDB (if needed)
MONGODB_URI=

# Network
NETWORK_NAME=appnet

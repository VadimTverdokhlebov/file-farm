# Template for file-based EDS. Runtime file: envoy/dynamic/endpoints.yaml
# Generated by lb-controller (IPs are resolved from Docker hostnames at runtime).
version_info: lb-controller
resources:
- '@type': type.googleapis.com/envoy.config.endpoint.v3.ClusterLoadAssignment
  cluster_name: grpc_backend
  endpoints:
  - lb_endpoints:
    - endpoint:
        address:
          socket_address:
            address: 0.0.0.0
            port_value: 50051
      load_balancing_weight: 100
    - endpoint:
        address:
          socket_address:
            address: 0.0.0.0
            port_value: 50051
      load_balancing_weight: 100
    - endpoint:
        address:
          socket_address:
            address: 0.0.0.0
            port_value: 50051
      load_balancing_weight: 100

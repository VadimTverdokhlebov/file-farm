# Production Environment Variables

ENVIRONMENT=production

# PostgreSQL Database
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_SECRET
POSTGRES_DB=appdb
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgres://app:CHANGE_ME_SECRET@postgres:5432/appdb

# Server Configuration
GRPC_PORT=50051
GRPC_PROTO_FILE=protos/service.proto
FILES_DIR=/src/uploads

# Envoy Configuration
ENVOY_PORT=8080
ENVOY_BACKEND_HOST=app
ENVOY_BACKEND_PORT=50051

# Client Configuration
CLIENT_PORT=5173
CLIENT_API_URL=http://localhost:8080

# Network
NETWORK_NAME=appnet

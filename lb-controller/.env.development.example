EDS_PATH=../envoy/dynamic/endpoints.yaml
UPDATE_INTERVAL_SEC=5
# LB_ALGORITHM=am_ppo
LB_ALGORITHM=round_robin
# LB_ALGORITHM=weighted_round_robin
# LB_ALGORITHM=ema
# LB_ALGORITHM=least_request
# LB_ALGORITHM=least_connections  # alias for least_request
CLUSTER_NAME=grpc_backend
METRICS_PORT=9093
CONTROL_PORT=9094

BACKENDS=server-1:172.17.0.1:50051
RESOLVE_BACKEND_HOSTS=false

METRICS_SOURCE=prometheus
PROMETHEUS_URL=http://localhost:9090
BACKEND_WEIGHTS=100,100,100
DQN_WEIGHT_TOTAL=1000
DQN_EPSILON=0.1
AM_PPO_LEARNING_RATE=0.0003
AM_PPO_GAMMA=0.99
AM_PPO_GAE_LAMBDA=0.95
AM_PPO_CLIP_EPSILON=0.2
AM_PPO_UPDATE_EPOCHS=4
AM_PPO_ROLLOUT_SIZE=32
AM_PPO_VALUE_COEFFICIENT=0.5
AM_PPO_ENTROPY_COEFFICIENT=0.01
AM_PPO_LATENCY_SLA_SECONDS=0.2
AM_PPO_REWARD_LATENCY_WEIGHT=1.0
AM_PPO_REWARD_ERROR_WEIGHT=10.0
AM_PPO_REWARD_CPU_WEIGHT=2.0
AM_PPO_REWARD_CHURN_WEIGHT=0.5
AM_PPO_MODEL_PATH=./data/am_ppo_model.pt
BACKEND_CPU_LIMITS=1
BACKEND_MEMORY_LIMITS_GB=1

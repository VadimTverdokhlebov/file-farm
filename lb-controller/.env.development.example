EDS_PATH=../envoy/dynamic/endpoints.yaml
UPDATE_INTERVAL_SEC=1
LB_ALGORITHM=round_robin
CLUSTER_NAME=grpc_backend
METRICS_PORT=9093

# Dev default: lb-controller runs locally, Envoy and backend servers run in Docker.
BACKENDS=server-1:file-farm-server-1:50051,server-2:file-farm-server-2:50051,server-3:file-farm-server-3:50051
RESOLVE_BACKEND_HOSTS=false

# If the backend server runs locally through npm, use this instead:
# BACKENDS=server-local:host.docker.internal:50051
# METRICS_SOURCE=stub
# BACKEND_WEIGHTS=100
# BACKEND_CPU_LIMITS=1
# BACKEND_MEMORY_LIMITS_GB=1

METRICS_SOURCE=prometheus
PROMETHEUS_URL=http://localhost:9090
BACKEND_WEIGHTS=100,100,100
DQN_WEIGHT_TOTAL=1000
DQN_EPSILON=0.1
BACKEND_CPU_LIMITS=1,1,1
BACKEND_MEMORY_LIMITS_GB=1,1,1
